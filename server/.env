PORT=5000
# MONGO_URI = mongodb+srv://iamjahnvidwivedi_db_user:Oct2207@cluster0.gew8mo2.mongodb.net/?appName=Cluster0

# MONGO_URI=mongodb://iamjahnvidwivedi_db_user:Oct2207@cluster0.gew8mo2.mongodb.net/nextStep?retryWrites=true&w=majority

# the difference between the later and former MONGO_URI is that the prev one is being copied directly from mongo.db website and it says that app name will be connected to cluster0, the cluster we opt in mongo.db website
# but the next link writes retryWrites=true&w=majority after app name , which nt only connects the app to cluster0 but also ensures that just in case if internet connection falls off momentarily then it should retry the write operation and waits(w) for majority of cloud nodes to confirm that data is saved safely.



MONGO_URI=mongodb://iamjahnvidwivedi_db_user:Oct2207@ac-yhhronx-shard-00-00.gew8mo2.mongodb.net:27017,ac-yhhronx-shard-00-01.gew8mo2.mongodb.net:27017,ac-yhhronx-shard-00-02.gew8mo2.mongodb.net:27017/nextStep?ssl=true&replicaSet=atlas-y2ni62-shard-0&authSource=admin&appName=Cluster0

# // FIXED DATABASE CONNECTION ISSUE:
# // 1. Whitelisted '0.0.0.0/0' in MongoDB Atlas to permit access across dynamic ISP IP changes.
# // 2. Switched from 'mongodb+srv://' to a Legacy Standard URI connection string.
